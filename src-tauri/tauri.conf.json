{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/schemas/tauri/schema.json",
  "productName": "Mermaid Live Editor",
  "version": "2.0.67",
  "identifier": "com.mermaid.live-editor",
  "build": {
    "frontendDist": "../docs",
    "devUrl": "http://localhost:31551",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Mermaid Live Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mmd", "mermaid"],
        "name": "Mermaid Diagram",
        "description": "Mermaid diagram source file",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
